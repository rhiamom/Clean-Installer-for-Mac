<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sims2Pack.Installer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="660"
        x:Class="Sims2Pack.Installer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="660"
        MinWidth="800" MinHeight="500">

    <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto,Auto">

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#C7D2E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Original Sims2Pack Installer icon (misdocs.ico, 16×16).
                     Nearest-neighbor scaling keeps the upscaled icon crisp/
                     intentionally-pixelated rather than blurry. Swap in a
                     higher-res PNG (plumbob etc.) when available. -->
                <Image Grid.Column="0"
                       Source="/Assets/sims2pack-icon.ico"
                       Width="48" Height="48"
                       Margin="0,0,12,0"
                       RenderOptions.BitmapInterpolationMode="None"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding PackName}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#2E5C8A"/>
                    <TextBlock Text="{Binding PackType}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#2E5C8A"/>
                    <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,6,0,0">
                        <CheckBox Content="Preview images"
                                  IsChecked="{Binding PreviewImages}"
                                  Foreground="#2E5C8A"/>
                        <CheckBox Content="Remove furniture"
                                  IsChecked="{Binding RemoveFurniture}"
                                  Foreground="#2E5C8A"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Bottom">
                    <StackPanel.Styles>
                        <Style Selector="ToggleButton.installMode">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                        <Style Selector="ToggleButton.installMode TextBlock.caption">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="#2E5C8A"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,2,0,0"/>
                        </Style>
                    </StackPanel.Styles>
                    <ToggleButton Classes="installMode"
                                  IsChecked="{Binding IsEverythingMode, Mode=OneWay}"
                                  Command="{Binding SetInstallModeCommand}"
                                  CommandParameter="Everything">
                        <StackPanel>
                            <Image Source="/Assets/install-mode-everything.bmp"
                                   Width="28" Height="28"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                            <TextBlock Classes="caption" Text="Everything"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="installMode"
                                  IsChecked="{Binding IsHouseOnlyMode, Mode=OneWay}"
                                  Command="{Binding SetInstallModeCommand}"
                                  CommandParameter="HouseOnly">
                        <StackPanel>
                            <Image Source="/Assets/install-mode-house.bmp"
                                   Width="28" Height="28"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                            <TextBlock Classes="caption" Text="House only"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="installMode"
                                  IsChecked="{Binding IsHouseAndFamilyMode, Mode=OneWay}"
                                  Command="{Binding SetInstallModeCommand}"
                                  CommandParameter="HouseAndFamily">
                        <StackPanel>
                            <Image Source="/Assets/install-mode-house-and-family.bmp"
                                   Width="28" Height="28"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                            <TextBlock Classes="caption" Text="House + family"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="installMode"
                                  IsChecked="{Binding IsHouseWithoutHacksMode, Mode=OneWay}"
                                  Command="{Binding SetInstallModeCommand}"
                                  CommandParameter="HouseWithoutHacks">
                        <StackPanel>
                            <Image Source="/Assets/install-mode-house-without-hacks.bmp"
                                   Width="28" Height="28"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                            <TextBlock Classes="caption" Text="Without hacks"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="0,10,0,0">
            <DataGrid.Styles>
                <Style x:DataType="vm:PackageItemViewModel" Selector="DataGridRow">
                    <Setter Property="Background" Value="{Binding BackgroundBrush}"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="32"/>
                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="320"/>
                <DataGridTextColumn Header="Type"     Binding="{Binding TypeName}" Width="160"/>
                <DataGridTextColumn Header="MD5"      Binding="{Binding Md5}"      Width="200"/>
                <DataGridTextColumn Header="FileName" Binding="{Binding FileName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                BorderBrush="#C7D2E0"
                BorderThickness="0,1,0,1"
                Padding="8,12">
            <Grid ColumnDefinitions="Auto,220,*" Height="80">
                <Image Grid.Column="0"
                       Source="{Binding SelectedPreviewImage}"
                       Width="64" Height="64"
                       Stretch="Uniform"
                       Margin="0,0,12,0"
                       IsVisible="{Binding PreviewImages}"/>
                <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Version" Foreground="#2E5C8A" Width="70"/>
                        <TextBlock Text="{Binding SelectedVersion}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Author" Foreground="#2E5C8A" Width="70"/>
                        <TextBlock Text="{Binding SelectedAuthor}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top">
                    <TextBlock Text="Description" Foreground="#2E5C8A"/>
                    <ScrollViewer MaxHeight="60"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedDescription}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="#666"
                   FontStyle="Italic"/>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0"
                    Content="Update"
                    Command="{Binding UpdateCommand}"
                    Padding="18,6"/>
            <Button Grid.Column="2"
                    Content="Save As..."
                    Command="{Binding SaveAsCommand}"
                    Padding="18,6"
                    Margin="6,0"/>
            <Button Grid.Column="3"
                    Content="Install"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding CanInstall}"
                    IsDefault="True"
                    Padding="18,6"
                    Margin="6,0"
                    Classes="accent"/>
            <Button Grid.Column="4"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Padding="18,6"
                    Margin="6,0"/>
        </Grid>
    </Grid>
</Window>
