<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Sims2Pack.Installer.Views"
        x:Class="Sims2Pack.Installer.Views.TexturePreviewWindow"
        x:DataType="views:TexturePreviewItem"
        Title="Textures"
        Width="520" Height="600"
        MinWidth="240" MinHeight="200"
        MaxWidth="520" MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        CanResize="True">
    <Grid RowDefinitions="*,Auto" Margin="8">
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TextureList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:TexturePreviewItem">
                        <StackPanel Margin="0,0,0,8" Spacing="2">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="11"
                                       Foreground="#2E5C8A"/>
                            <Border BorderBrush="#C7D2E0"
                                    BorderThickness="1"
                                    Background="#1A1A1A"
                                    Padding="4">
                                <Image Source="{Binding Image}"
                                       Stretch="Uniform"
                                       MaxWidth="480"
                                       MaxHeight="480"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="1"
                Content="Close"
                Click="OnCloseClick"
                HorizontalAlignment="Right"
                Padding="18,6"
                Margin="0,8,0,0"
                IsCancel="True"
                IsDefault="True"/>
    </Grid>
</Window>
