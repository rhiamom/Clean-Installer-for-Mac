<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Sims2Pack.Installer.Views"
        x:Class="Sims2Pack.Installer.Views.WindowsContentWarningDialog"
        x:DataType="views:FlaggedItem"
        Title="Windows-only Sims 2 content"
        Width="600" Height="460"
        MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        CanResize="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto,*,Auto" Margin="14">

        <!-- Hard-block heading + list (visible only if any) -->
        <TextBlock Grid.Row="0"
                   x:Name="HardBlockHeading"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"
                   Foreground="#A00000"
                   FontWeight="SemiBold"
                   Text="These items require Sims 2 content not available on Mac (Free Time, Apartment Life, or Mansion &amp; Garden Stuff) and will crash the game. Install is blocked."/>
        <Border Grid.Row="1"
                x:Name="HardBlockBorder"
                BorderBrush="#A00000"
                BorderThickness="1"
                Padding="2"
                Background="#FFF0F0"
                Margin="0,0,0,10"
                MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HardBlockList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:FlaggedItem">
                            <StackPanel Margin="6,4" Spacing="0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Soft-warn heading + list (visible only if any) -->
        <TextBlock Grid.Row="2"
                   x:Name="SoftWarnHeading"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"
                   Foreground="#2E5C8A"
                   Text="These items reference Sims 2 stuff packs not released on Mac. If you have Huge Lunatic's standalone extractions installed (in Downloads or your game files), the lot will load. Otherwise the game will crash."/>
        <Border Grid.Row="3"
                x:Name="SoftWarnBorder"
                BorderBrush="#C7D2E0"
                BorderThickness="1"
                Padding="2"
                Background="White"
                MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SoftWarnList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:FlaggedItem">
                            <StackPanel Margin="6,4" Spacing="0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,10,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancelClick"
                    Padding="18,6"
                    IsCancel="True"/>
            <Button x:Name="OverrideButton"
                    Content="I have the extractions, install anyway"
                    Click="OnOverrideClick"
                    Padding="18,6"
                    Background="#DCE7F2"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Click="OnCancelClick"
                    Padding="24,6"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
